# The Go server's settings, read by deploy/outpost-go.service from ~/.config/outpost-go/env.
# Copy this file there with mode 600 and fill in the blanks. No real values belong in this file.

# --- Server (outpost-go serve) ---
# Postgres from deploy/stack.sh. Use the same password as OB_PG_PASSWORD below.
OUTPOST_DATABASE_URL=postgres://outpost:CHANGE_ME@127.0.0.1:5433/outpost
# Where the server listens, where people reach it, and the URL agents dial.
OUTPOST_LISTEN=:7400
OUTPOST_PUBLIC_URL=http://localhost:7400
OUTPOST_AGENT_URL=ws://127.0.0.1:7400/machines/link
# Base64 of 32 bytes; `outpost-go key` prints one. Secrets are sealed with it: keep it safe.
OUTPOST_SECRET_KEY=
# The image every box starts from, and how many boxes run at once.
OUTPOST_BASE_IMAGE=
OUTPOST_MAX_RUNNING=2
# GitHub logins allowed to sign in, comma separated.
OUTPOST_ALLOWED_LOGINS=
# Claude Code: the model, the command in the box (empty is the tools image's), and the plugin
# marketplaces (owner/repo or a git URL) and plugins (name@marketplace) every fresh agent home gets.
OUTPOST_CLAUDE_MODEL=
OUTPOST_CLAUDE_BIN=
OUTPOST_CLAUDE_MARKETPLACES=
OUTPOST_CLAUDE_PLUGINS=
# Migrate the database at start.
OUTPOST_MIGRATE=true
# The credential proxy from deploy/stack.sh. Boxes dial OUTPOST_PROXY_URL on the boxes network;
# the CA file is where stack.sh puts the proxy's public CA; the token is at least 16 characters
# and is what the proxy presents for grants. Leave OUTPOST_PROXY_URL empty to run boxes with no
# credentials.
OUTPOST_PROXY_URL=http://ob-proxy:8080
OUTPOST_PROXY_CA_FILE=/home/USER/.local/share/outpost-go/proxy/ca/mitmproxy-ca-cert.pem
OUTPOST_PROXY_TOKEN=
# The drain budget on stop, and the log level (debug, info, warn, error).
OUTPOST_DRAIN=60s
OUTPOST_LOG=info

# --- deploy/stack.sh only ---
OB_PG_PASSWORD=CHANGE_ME

# --- Machine agent (outpost-go-agent run), in ~/.config/outpost-go/agent.env ---
# Where pair keeps the machine's key, the tools image mounted in every box, and the box names,
# labels, network and memory limit. The defaults keep clear of everything else on the host.
# OUTPOST_AGENT_DIR=
# OUTPOST_TOOLS_IMAGE=ob-tools:dev
# OUTPOST_BOX_PREFIX=ob
# OUTPOST_BOX_LABEL=dev.outpost.box
# OUTPOST_BOX_NETWORK=outpost-boxes
# OUTPOST_BOX_MEMORY=

# --- outpost-cli, on a laptop ---
# OUTPOST_SERVER=http://localhost:7400
# OUTPOST_TOKEN=
# OUTPOST_CLI_CONFIG=
